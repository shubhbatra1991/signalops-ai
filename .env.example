# SignalOps-AI starts safely as a deterministic public demonstration.
SIGNALOPS_DEPLOYMENT_MODE=public-demo
AI_ENABLE_PROVIDER_REQUESTS=false

# Required for non-local deployments. Use the exact HTTPS origin with no path.
# AI_APP_ORIGIN=https://signalops.example.com

# To enable BYOK locally, change the mode to self-hosted and enable requests.
# SIGNALOPS_DEPLOYMENT_MODE=self-hosted
# AI_ENABLE_PROVIDER_REQUESTS=true

# Hosted mode reserves authenticated workspace operation for Stage 4.2.
# Guest and workspace provider requests remain disabled until that authorization boundary exists.
# SIGNALOPS_DEPLOYMENT_MODE=hosted
# AI_ENABLE_PROVIDER_REQUESTS=false

# Optional operator-managed server credential configuration.
# Choose exactly one allowlisted provider/model pair and its matching key.
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=

# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# AI_PROVIDER=zai
# AI_MODEL=glm-4.7
# ZAI_API_KEY=

# Additional explicit permissions for operator-managed server keys.
AI_ALLOW_SERVER_KEY_TESTS=false
AI_ALLOW_SERVER_KEY_INSIGHTS=false
